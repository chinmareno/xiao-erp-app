// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPERADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean
  image         String?
  sessions      Session[]
  accounts      Account[]

  role UserRole @default(USER)

  companyMember CompanyMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

enum CompanyModules {
  SALES
  INVENTORY
  PURCHASING
}

model Company {
  id       String           @id @default(cuid())
  name     String
  address  String
  industry String
  desc     String?
  modules  CompanyModules[] @default([PURCHASING, INVENTORY, SALES])

  inviteLink InviteLink[]

  suppliers Supplier[]
  companyMember CompanyMember[]
  purchaseOrders PurchaseOrder[]
  poNumberFormat PONumberFormat?

  item        Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  warehouses Warehouse[]
}

enum CompanyRole {
  OWNER
  ADMIN
  EMPLOYEE
}

model CompanyMember {
  id       String      @id @default(cuid())
  role     CompanyRole @default(EMPLOYEE)
  joinedAt DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  permissions CompanyModules[]
  
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

enum ContactType {
  SUPPLIER
  SALES
  INVENTORY
}

model Contact {
  id    String  @id @default(cuid())
  name  String
  type  ContactType @default(SUPPLIER)
  email String?
  phone String?
  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
}

model InviteLink {
  id    String @id @default(cuid())
  token String @unique

  createdAt DateTime @default(now())
  expiresAt DateTime

  permissions CompanyModules[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

}

model Supplier {
  id      String  @id @default(cuid())
  name    String
  taxId   String?
  address String
  notes   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contact Contact[]

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  products       SupplierProduct[]
  purchaseOrders PurchaseOrder[]

}

enum ItemCategory {
  RAW_MATERIAL
  SUPPORTING_MATERIAL
  FINISHED_GOODS
}

model Item {
  id        String    @id @default(cuid())
  name      String
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category ItemCategory @default(FINISHED_GOODS)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  supplierProducts  SupplierProduct[]
  purchaseOrderItems PurchaseOrderItem[]

  @@unique([name,companyId])
}

enum PriceCurrency {
  IDR
  YUAN
}

model SupplierProduct {
  id                 String              @id @default(cuid())
  itemId             String
  item               Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplierId         String
  supplier           Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  price              Int
  priceCurrency      PriceCurrency
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  stockItems         StockItem[]

}

model Warehouse {
  id         String      @id @default(cuid())
  name       String
  location   String?
  pic        String?  
  companyId  String
  company    Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  stockItems StockItem[]
}

model StockItem {
  id          String    @id @default(cuid())
  supplierProductId   String
  supplierProduct     SupplierProduct   @relation(fields: [supplierProductId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Int
  costIdr     Float 
  costYuan    Float
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum PurchaseOrderStatus {
  UNRECEIVED
  RECEIVED
  INACTIVE
}

model PONumberFormat {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prefix      String   
  currentNumber Int    @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([companyId])
}

model PurchaseOrder {
  id               String              @id @default(cuid())
  supplierId       String
  supplier         Supplier            @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  supplierContactId        String
  companyId        String
  company          Company            @relation(fields: [companyId ], references: [id], onDelete: Cascade)
  @@unique([companyId, PONumber])
  priceCurrency            PriceCurrency @default(IDR)
  supplierName             String
  supplierContactName      String
  supplierContactEmail     String?
  supplierContactPhone     String?
  supplierAdress           String
  customerName             String
  customerContactName      String
  customerContactEmail     String?
  customerContactPhone     String?
  customerAddress          String

  discount                   Float 
  tax                        Float 
  subTotal                 String
  discountTotal                String
  taxTotal                 String
  grandTotal                 String


  PONumber          String
  status           PurchaseOrderStatus @default(UNRECEIVED)
  isActive         Boolean @default(true)
  lastReceivedDate  DateTime?
  expectedFullReceivedDate DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  
  POItems            PurchaseOrderItem[]
}

model YuanIdrRate {
  id         String   @id @default(cuid())
  yuanToIdrRate  Float
  idrToYuanRate  Float
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}


model PurchaseOrderItem {
  id              String   @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  itemId          String
  item            Item  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  itemName        String
  itemCategory    ItemCategory 

  unit            String              @default("pcs")
  quantity        Int
  costYuan        Float
  costIdr         Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
